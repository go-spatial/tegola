// Maps Worker configuration defines development, staging, and production R2 bindings, custom domains, caching policies, and observability for immutable manifests, tiles, glyphs, sprites, and private artifacts.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maps-worker-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-19",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "maps-dev"
    }
  ],
  "routes": [
    {
      "pattern": "maps-dev.meistercrm.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "*",
    "IMMUTABLE_CACHE_CONTROL": "public, max-age=31536000, immutable",
    "MANIFEST_CACHE_CONTROL": "public, max-age=60"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "env": {
    "staging": {
      "name": "maps-worker-staging",
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "maps-staging"
        }
      ],
      "routes": [
        {
          "pattern": "maps-staging.meistercrm.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ALLOWED_ORIGINS": "*",
        "IMMUTABLE_CACHE_CONTROL": "public, max-age=31536000, immutable",
        "MANIFEST_CACHE_CONTROL": "public, max-age=60"
      }
    },
    "production": {
      "name": "maps-worker",
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "maps-prod"
        }
      ],
      "routes": [
        {
          "pattern": "maps.meistercrm.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ALLOWED_ORIGINS": "*",
        "IMMUTABLE_CACHE_CONTROL": "public, max-age=31536000, immutable",
        "MANIFEST_CACHE_CONTROL": "public, max-age=60"
      }
    }
  }
}
